        { "id": "run_ro3", "objective": "Shares a terminal", "tasks": [{ "id": "task_ro3", "status": "dispatched", "dispatchId": "ctx_ro0000000003", "assignee": "term_both" }], "workers": [{ "dispatchId": "ctx_ro0000000003", "taskId": "task_ro3", "state": "ready", "liveness": "live", "terminal": "term_both" }] },
        { "id": "run_ro4", "objective": "Shares it too", "tasks": [{ "id": "task_ro4", "status": "dispatched", "dispatchId": "ctx_ro0000000004", "assignee": "term_both" }], "workers": [{ "dispatchId": "ctx_ro0000000004", "taskId": "task_ro4", "state": "ready", "liveness": "live", "terminal": "term_both" }] }
      ],
      "waits": [
        { "key": "agent:term_reuse", "kind": "agent", "target": { "kind": "terminal", "terminalId": "term_reuse" } },
        { "key": "agent:term_both", "kind": "agent", "target": { "kind": "terminal", "terminalId": "term_both" } }
      ],
      "expect": {
        "pieces": {
          "item:it-live": { "stage": "execution", "amber": true, "waits": ["agent:term_reuse"] },
          "item:it-old": { "stage": "planning", "amber": false, "waits": [] },
          "run:run_ro3": { "stage": "execution", "amber": false },
          "run:run_ro4": { "stage": "execution", "amber": false }
        },
        "unlinked": ["agent:term_both"]
      }
    },
    {
      "name": "Nit 7: a Run naming the item's older PRD joins the item",
      "items": [{ "uid": "it-twoprd", "status": "planned", "description": "v1 https://claude.ai/artifact/PrdOldGggg1 then https://claude.ai/artifact/PrdNewGggg2" }],
      "runs": [{ "id": "run_oldprd", "objective": "Per https://claude.ai/artifact/PrdOldGggg1", "tasks": [{ "id": "task_op1", "status": "pending" }] }],
