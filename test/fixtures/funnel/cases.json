        "run:run_failnoworker": { "stage": "planning", "why": "Run failed", "amber": true, "failed": [] },
        "run:run_failmerged": { "stage": "planning", "why": "Run failed", "amber": true },
        "run:run_onegood": { "stage": "shipping", "why": "Run finished", "amber": false }
